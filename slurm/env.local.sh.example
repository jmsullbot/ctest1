# Site-local environment configuration.
#
#   cp slurm/env.local.sh.example slurm/env.local.sh
#   # edit slurm/env.local.sh to match your setup
#
# slurm/env.local.sh is gitignored, so your paths survive re-unzipping the
# repo and never end up in version control.  It is sourced by every sbatch
# script (via slurm/_common.sh) and by slurm/setup_env.sh.


# --- Option A: point at your own conda installation (most common) ----------
# CONDA_BASE is the directory containing etc/profile.d/conda.sh.
# Find it by running, in your normal shell:   conda info --base

CONDA_BASE=/global/homes/j/jsull/miniconda3     # <-- EDIT THIS
CONDA_ENV=abacus                                 # env name, or a full prefix path


# --- Option B: use NERSC's conda module instead -----------------------------
# USE_CONDA_MODULE=1
# CONDA_ENV=abacus


# --- Option C: do the activation entirely yourself --------------------------
# If you already have a script that sets up your environment, source it here
# and set ENV_READY=1 to tell _common.sh to skip its own conda handling.
#
# source /path/to/my_env_setup.sh
# ENV_READY=1


# --- Optional: where catalogs are written ----------------------------------
# OUTDIR=$PSCRATCH/lrg_hods
